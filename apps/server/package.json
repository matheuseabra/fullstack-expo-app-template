{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@fullstack-expo-app-template/env": "workspace:*",
    "@fullstack-expo-app-template/api": "workspace:*",
    "@fullstack-expo-app-template/auth": "workspace:*",
    "@fullstack-expo-app-template/db": "workspace:*",
    "libsql": "catalog:",
    "hono": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsdown": "^0.22.14",
    "@fullstack-expo-app-template/config": "workspace:*",
    "@types/bun": "catalog:"
  }
}