BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# RevenueCat webhook shared secret (optional locally; required to receive purchase events)
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret

# This path resolves to apps/server/local.db from both the server and db package.
DATABASE_URL=file:../../apps/server/local.db
DATABASE_AUTH_TOKEN=local-dev-token
